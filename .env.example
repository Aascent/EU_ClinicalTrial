# ==============================================================================
# Clinical Trial Platform - Global Docker Compose Configuration
# ==============================================================================

# Port Mappings
EU_PORT=8080
ANZ_PORT=8081

# Startup Modes ('status', 'check', 'report', 'incremental', 'historical')
EU_STARTUP_MODE=status
ANZ_STARTUP_MODE=status

# Run startup action on container start
EU_RUN_ON_STARTUP=true
ANZ_RUN_ON_STARTUP=true

# Cron Schedules
EU_CRON_SCHEDULE=0 2 * * *
ANZ_CRON_SCHEDULE=0 3 * * *

