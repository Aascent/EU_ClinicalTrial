# ==============================================================================
# AWS Credentials & Configuration (Template)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# ==============================================================================
# Amazon S3 Configuration
# ==============================================================================
S3_BUCKET_NAME=your_s3_bucket_name
S3_PREFIX=ctis/

# ==============================================================================
# Amazon DynamoDB Configuration
# ==============================================================================
DYNAMODB_TABLE_NAME=EU_Clinical
DYNAMODB_PARTITION_KEY=euc
TABLE_NAME=EU_Clinical
PARTITION_KEYS=euc

# ==============================================================================
# Pipeline & Application Settings
# ==============================================================================
CTIS_API_BASE_URL=https://euclinicaltrials.eu/ctis-public-api
MAX_WORKERS=5
LOOKBACK_DAYS=7
LOG_LEVEL=INFO

# Ingestion & State Backends ('s3', 'local', or 'both'; 'dynamodb', 'sqlite', or 'both')
STORAGE_BACKEND=s3
STATE_BACKEND=dynamodb
LOCAL_DATA_DIR=./data
