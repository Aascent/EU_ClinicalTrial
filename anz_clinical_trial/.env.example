# ==============================================================================
# ANZCTR Data Pipeline - Environment Configuration
# ==============================================================================

# API Configuration
ANZCTR_WS_URL=https://api.anzctr.org.au/WebServices/AnzctrWebservices.asmx
METHODOLOGY_URL=https://clinicaltrialsaustralia.io/methodology

# Storage Backend: 'local', 's3', or 'both'
STORAGE_BACKEND=local

# State Backend: 'sqlite', 'dynamodb', or 'both'
STATE_BACKEND=sqlite

# Local Paths
LOCAL_DATA_DIR=./data
SQLITE_DB_PATH=./tracker.db

# AWS Configuration (Used if STORAGE_BACKEND=s3 or STATE_BACKEND=dynamodb)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
S3_PREFIX=anzctr/
DYNAMODB_TABLE_NAME=ANZ_Clinical
DYNAMODB_PARTITION_KEY=anzctr

# Scheduling & Container Settings
RUN_ON_STARTUP=true
STARTUP_MODE=status
CRON_SCHEDULE=0 3 * * *
MAX_WORKERS=5
LOOKBACK_DAYS=7
LOG_LEVEL=INFO
PORT=8081

